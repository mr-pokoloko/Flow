//-----Handle Form Submission------

document.addEventListener("DOMContentLoaded", function(){

document
.getElementById("expense-form")
.addEventListener("submit", function(e){

    e.preventDefault();

    const name =
    document.getElementById("expense-name").value;

    const amount =
    document.getElementById("expense-amount").value;

    const category =
    document.getElementById("expense-category").value;

    let date =
    document.getElementById("expense-date").value;

    // convert DD/MM/YYYY → YYYY-MM-DD if needed
    if(date.includes("/")){
        let parts = date.split("/");
        date = `${parts[2]}-${parts[1]}-${parts[0]}`;
    }

    const expense = {
        name,
        amount,
        category,
        date
    };

    expenses.push(expense);

    addExpenseToTable(expense);

    updateCharts();

    updateBudgetStatus();

    document.getElementById("expense-form").reset();
});
});


//-----Add Expense to Table------

function addExpenseToTable(expense){

    const table =
    document.getElementById("expense-list");

    const row = document.createElement("tr");

    row.innerHTML = `
    <td>${expense.name}</td>
    <td>${expense.amount}</td>
    <td>${expense.category}</td>
    <td>${expense.date}</td>
    `;

    table.appendChild(row);

}

//-----Update Charts------

function updateCharts(){

let categoryTotals = {
Food:0,
Transport:0,
Shopping:0,
Bills:0
};

let dailyTotals = {};

expenses.forEach(exp => {

categoryTotals[exp.category] += Number(exp.amount);

if(!dailyTotals[exp.date]){
dailyTotals[exp.date] = 0;
}

dailyTotals[exp.date] += Number(exp.amount);

});

categoryChart.data.datasets[0].data =
Object.values(categoryTotals);

categoryChart.update();

dailyChart.data.labels =
Object.keys(dailyTotals);

dailyChart.data.datasets[0].data =
Object.values(dailyTotals);

dailyChart.update();

// Update monthly trend chart
updateMonthlyChart();

// Update total expense display
let total = 0;

expenses.forEach(e => {
total += Number(e.amount);
});

document.getElementById("total-expense").innerText =
"₹" + total;
document.getElementById("budget-balance").innerText =
"₹" - total;
}

//-----Calculate Spending for Month or Year------

function calculateSpending(){

let total = 0;

expenses.forEach(exp => {
total += Number(exp.amount);
});

return total;

}

//-----Budget Analysis Logic------

function updateBudgetStatus(){

let spent = calculateSpending();

if(isNaN(spent)) spent = 0;

let remaining = monthlyBudget - spent;

if(remaining < 0) remaining = 0;

// Update donut chart
budgetChart.data.datasets[0].data = [
spent,
remaining
];

budgetChart.update();

// Update budget card
const budgetBalance = document.getElementById("budget-balance");

if(budgetBalance){
budgetBalance.innerText = "₹" + remaining;
}

// Update status message
let message = "";

if(spent < monthlyBudget * 0.6){

message = "✅ You are doing great this month! Keep saving.";

}
else if(spent < monthlyBudget){

message = "⚠️ You are close to your monthly budget.";

}
else{

message = "❌ Warning: You exceeded your monthly budget.";

}

document.getElementById("budget-message").innerText = message;

}

//-----Update Monthly Trend Chart------

function updateMonthlyChart(){

let monthlyTotals = new Array(12).fill(0);

expenses.forEach(exp => {

const date = new Date(exp.date);
const month = date.getMonth();

if(month >= 0 && month < 12){
monthlyTotals[month] += Number(exp.amount);
}

});

monthlyChart.data.datasets[0].data = monthlyTotals;
monthlyChart.update();

}
